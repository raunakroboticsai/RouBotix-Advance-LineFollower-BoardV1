#define STBY 9

#define PWMA 5
#define AIN1 2
#define AIN2 4

#define PWMB 6
#define BIN1 7
#define BIN2 8

int baseSpeed = 150;

void setup() {
  pinMode(STBY, OUTPUT);
  digitalWrite(STBY, HIGH);

  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);

  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);
}

void loop() {

  // Straight
  motors(baseSpeed, baseSpeed);
  delay(2000);

  // Slight Left
  motors(baseSpeed - 50, baseSpeed);
  delay(2000);

  // Slight Right
  motors(baseSpeed, baseSpeed - 50);
  delay(2000);
}

void motors(int L, int R) {

  if (L >= 0) {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);
  } else {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);
    L = -L;
  }
  analogWrite(PWMA, L);

  if (R >= 0) {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);
  } else {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);
    R = -R;
  }
  analogWrite(PWMB, R);
}
